{% extends 'base.html.twig' %}

{% block body_class %}home-page{% endblock %}

{% block title %}{{ page.seoTitle }}{% endblock %}

{% block meta %}
    <meta name="description" content="{{ page.seoDescription }}">
    {% if page.ogTitle is not null %}
        <meta property="og:title" content="{{ page.ogTitle }}">
    {% endif %}
    {% if page.ogDescription is not null %}
        <meta property="og:description" content="{{ page.ogDescription }}">
    {% endif %}
{% endblock %}

{% block body %}
    <div data-controller="home-welcome" data-action="keydown.esc@window->home-welcome#close">
        <main class="home-shell">
            <header class="home-topbar" aria-label="Верхняя панель">
                <a class="home-brand" href="{{ path('app_home') }}" aria-label="{{ page.brandText }}">
                    <span class="home-brand__mark" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                    <span class="home-brand__text">{{ page.brandText }}</span>
                </a>

                <nav class="home-nav" aria-label="Навигация">
                    {% for item in page.navItems %}
                        <a href="{{ item.url }}">{{ item.label }}</a>
                    {% endfor %}
                </nav>
            </header>

            <section class="home-hero" aria-label="Главный экран">
                <div class="home-hero__copy">
                    <div class="home-eyebrow">
                        <span class="home-eyebrow__dot"></span>
                        {{ page.eyebrowText }}
                    </div>

                    <h1>{{ page.heroTitle }}</h1>

                    <p class="home-lead">{{ page.heroSubtitle }}</p>

                    <div class="home-actions">
                        <button class="home-btn home-btn--primary" type="button" data-action="home-welcome#open">
                            {{ page.primaryCtaLabel }}
                        </button>
                        <a class="home-btn home-btn--secondary" href="{{ page.secondaryCtaUrl }}">
                            {{ page.secondaryCtaLabel }}
                        </a>
                    </div>

                    <div class="home-trust-strip" aria-label="Ключевые сценарии">
                        {% for tag in page.trustTags %}
                            <span>{{ tag }}</span>
                        {% endfor %}
                    </div>
                </div>

                <div class="home-model-preview" id="example" aria-label="Пример финансовой модели">
                    <div class="home-preview-window">
                        <div class="home-window-head">
                            <div>
                                <span class="home-window-kicker">{{ page.previewKicker }}</span>
                                <h2>{{ page.previewTitle }}</h2>
                            </div>
                            <span class="home-status-pill">{{ page.previewStatus }}</span>
                        </div>

                        <div class="home-metrics-grid">
                            {% for metric in page.previewMetrics %}
                                <article class="home-metric-card{% if metric.isPrimary %} home-metric-card--strong{% endif %}">
                                    <span>{{ metric.label }}</span>
                                    <strong>{{ metric.value }}</strong>
                                    <small>{{ metric.note }}</small>
                                </article>
                            {% endfor %}
                        </div>

                        <div class="home-chart-card">
                            <div class="home-chart-head">
                                <span>{{ page.chartTitle }}</span>
                                <strong>{{ page.chartPeriod }}</strong>
                            </div>
                            <div class="home-bars" aria-hidden="true">
                                <span style="height: 34%"></span>
                                <span style="height: 48%"></span>
                                <span style="height: 58%"></span>
                                <span style="height: 76%"></span>
                                <span style="height: 88%"></span>
                            </div>
                        </div>

                        <div class="home-assistant-note">
                            <div class="home-assistant-icon" aria-hidden="true">AI</div>
                            <p>{{ page.assistantNote }}</p>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        {% include 'home/_welcome_popup.html.twig' with { page: page } only %}
    </div>
{% endblock %}
