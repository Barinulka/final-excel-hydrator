{% extends 'base.html.twig' %}

{% block body_class %}home-page{% endblock %}

{% block title %}{{ page.seoTitle }}{% endblock %}

{% block meta %}
    <meta name="description" content="{{ page.seoDescription }}">
    {% if page.ogTitle is not null %}
        <meta property="og:title" content="{{ page.ogTitle }}">
    {% endif %}
    {% if page.ogDescription is not null %}
        <meta property="og:description" content="{{ page.ogDescription }}">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="background-glow"></div>
    <div class="background-pulse"></div>

    <div class="splash-container">
        <div class="splash-logo">
            <div class="logo-ring-outer">
                <div class="atom-outer"></div>
            </div>

            <div class="logo-ring-inner">
                <div class="atom-inner"></div>
            </div>

            <div class="logo-center">
                <div class="logo-hexagon">
                    <svg viewBox="0 0 36 36">
                        <polygon points="18,2 33,10 33,26 18,34 3,26 3,10"/>
                    </svg>
                    <div class="logo-hexagon-core"></div>
                </div>
            </div>
        </div>

        <h1 class="splash-welcome">
            {{ page.heroTitle }}
        </h1>

        <p class="splash-subtitle">
            {{ page.heroSubtitle|nl2br }}
        </p>

        <a class="splash-button" href="{{ page.ctaUrl }}">{{ page.ctaLabel }}</a>

        <div class="loading-indicator">
            <div class="loading-dot"></div>
            <div class="loading-dot"></div>
            <div class="loading-dot"></div>
        </div>
    </div>
{% endblock %}
