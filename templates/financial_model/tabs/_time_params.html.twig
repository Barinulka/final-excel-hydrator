<form
    id="financial-model-time-params-form"
    class="model-settings-panel"
    data-action="submit->time-params-edit#submit"
    novalidate
>
    <div class="model-settings-panel__header">
        <h3 class="model-settings-panel__title">Временные параметры</h3>
        <p class="model-settings-panel__text">Этот блок задает расчетный горизонт модели. Остальные вкладки будут опираться на эти периоды.</p>
    </div>

    <div class="model-settings-panel__body">
        {% include 'financial_model/tabs/_time_params_fields.html.twig' with {
            page: page,
        } only %}
    </div>

    <div class="model-settings-panel__actions">
        <span class="model-settings-panel__hint">Изменения сохраняются через кнопку внизу страницы.</span>
    </div>
</form>
