{% extends 'base.html.twig' %}

{% block title %}{{ page.pageTitle }}{% endblock %}

{% block body_class %}financial-model-page{% endblock %}

{% block body %}
<main
    class="app-shell"
    data-controller="financial-model-workspace-shell financial-model-inline-rename"
    data-financial-model-inline-rename-api-url-value="{{ path('api.financial_model.rename', {
        financialModelShortId: page.financialModelShortId,
    }) }}"
>
    {% include 'financial_model/partials/_sidebar.html.twig' with {
        page: page,
    } only %}

    <div
        class="main-area model-workspace{% if page.isFinancialModelArchived %} model-workspace--archived{% endif %}"
        data-controller="{% if page.activeTab.key == 'input_params' %}time-params-edit {% endif %}financial-model-summary excel-export-create"
        {% if page.activeTab.key == 'input_params' %}
            data-time-params-edit-api-url-value="{{ path('api.time_params.update', {
                financialModelShortId: page.financialModelShortId,
            }) }}"
        {% endif %}
        data-financial-model-summary-api-url-value="{{ path('api.financial_model.summary', {
            financialModelShortId: page.financialModelShortId,
        }) }}"
        data-excel-export-create-api-url-value="{{ path('api.excel_export.create', {
            financialModelShortId: page.financialModelShortId,
        }) }}"
        data-action="financial-model-summary:refresh->financial-model-summary#refresh"
    >
        <turbo-frame
            id="financial-model-main"
            data-financial-model-workspace-shell-target="frame"
            data-action="turbo:frame-load->financial-model-workspace-shell#syncActiveFromUrl"
        >
            {% include 'financial_model/partials/_topbar.html.twig' with {
                page: page,
            } only %}

            {% include 'financial_model/partials/_management_panel.html.twig' with {
                page: page,
            } only %}

            {% include 'financial_model/partials/_content_shell.html.twig' with {
                page: page,
            } only %}

            {% include 'financial_model/partials/_bottombar.html.twig' with {
                page: page,
            } only %}
        </turbo-frame>
    </div>
</main>
{% endblock %}
