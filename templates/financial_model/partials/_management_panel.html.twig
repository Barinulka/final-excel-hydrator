<section class="fields-row">
    <div class="field-group">
        <label class="field-label" for="financial_model_title_inline">Название модели</label>
        <input
            id="financial_model_title_inline"
            class="field-input"
            type="text"
            maxlength="255"
            value="{{ page.financialModelTitle }}"
            autocomplete="off"
            data-financial-model-inline-rename-target="input"
            data-action="input->financial-model-inline-rename#sync blur->financial-model-inline-rename#save keydown.enter->financial-model-inline-rename#submitOnEnter"
            {% if page.isFinancialModelArchived %}disabled{% endif %}
        >
        <span
            class="project-form__client-error field-error"
            data-financial-model-inline-rename-target="error"
        ></span>
    </div>

    <div class="field-group">
        <label class="field-label" for="financial_model_description_inline">Краткое описание</label>
        <input
            id="financial_model_description_inline"
            class="field-input"
            type="text"
            value=""
            placeholder="Поле описания подключим после добавления в модель"
            disabled
        >
        <span class="field-note">Сейчас это только визуальный блок. Для сохранения описания нужен отдельный backend-шаг.</span>
    </div>
</section>
