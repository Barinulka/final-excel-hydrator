<dialog
    class="financial-model-create-dialog model-create-dialog"
    aria-labelledby="financialModelCreateTitle"
    data-financial-model-create-target="dialog"
    data-action="click->financial-model-create#backdropClick"
>
    <form
        class="financial-model-create-dialog__form model-create-dialog__form"
        data-action="submit->financial-model-create#submit"
        method="dialog"
    >
        <button
            class="model-create-dialog__close"
            type="button"
            aria-label="Закрыть окно создания модели"
            data-action="financial-model-create#close"
        >
            ×
        </button>

        <aside class="model-create-dialog__visual" aria-hidden="true">
            <div class="model-create-dialog__icon">
                <svg viewBox="0 0 72 72" fill="none">
                    <path d="M18 52V20M32 52V30M46 52V16M58 52H14" stroke="currentColor" stroke-linecap="round" stroke-width="5"/>
                </svg>
            </div>
            <div class="model-create-dialog__visual-copy">
                <span>Новая модель</span>
                <strong>Финансовая структура проекта</strong>
                <p>Название, описание и временные параметры станут основой расчетов.</p>
            </div>
        </aside>

        <section class="model-create-dialog__content">
            <div class="financial-model-create-dialog__header model-create-dialog__header">
                <p class="model-create-dialog__kicker">Создание модели</p>
                <h3 class="financial-model-create-dialog__title model-create-dialog__title" id="financialModelCreateTitle">
                    Новая финансовая модель
                </h3>
                <p class="financial-model-create-dialog__text model-create-dialog__text">
                    Укажите название, краткое описание и временные параметры модели.
                </p>
            </div>

            <div class="model-create-dialog__fields">
                <label class="project-form__field">
                    <span class="project-form__label">Название модели</span>
                    <input
                        class="project-form__input"
                        type="text"
                        maxlength="255"
                        autocomplete="off"
                        data-financial-model-create-target="title"
                    >
                    <span class="project-form__error" data-financial-model-create-target="titleError"></span>
                </label>

                <label class="project-form__field">
                    <span class="project-form__label">Краткое описание</span>
                    <textarea
                        class="project-form__textarea"
                        maxlength="2000"
                        rows="3"
                        data-financial-model-create-target="description"
                    ></textarea>
                    <span class="project-form__error" data-financial-model-create-target="descriptionError"></span>
                </label>

                <div class="model-create-dialog__field-grid">
                    <label class="project-form__field">
                        <span class="project-form__label">Дата начала инвестиций</span>
                        <div class="month-picker" data-controller="month-picker">
                            <input
                                type="hidden"
                                data-month-picker-target="input"
                                data-action="change->month-picker#syncFromInput"
                                data-financial-model-create-target="investmentStartMonth"
                            >
                            <button
                                class="month-picker__trigger"
                                type="button"
                                aria-haspopup="dialog"
                                aria-expanded="false"
                                data-month-picker-target="trigger"
                                data-action="month-picker#toggle"
                                data-financial-model-create-target="investmentStartMonthTrigger"
                            >
                                Выберите месяц
                            </button>
                            <div class="month-picker__panel" data-month-picker-target="panel" hidden>
                                <div class="month-picker__header">
                                    <button class="month-picker__nav" type="button" data-action="month-picker#previousYear" aria-label="Предыдущий год">‹</button>
                                    <strong class="month-picker__year" data-month-picker-target="year"></strong>
                                    <button class="month-picker__nav" type="button" data-action="month-picker#nextYear" aria-label="Следующий год">›</button>
                                </div>
                                <div class="month-picker__months" data-month-picker-target="months"></div>
                            </div>
                        </div>
                        <span class="project-form__error" data-financial-model-create-target="investmentStartMonthError"></span>
                    </label>

                    <label class="project-form__field">
                        <span class="project-form__label">Шаг прогнозирования</span>
                        <select
                            class="project-form__select"
                            data-financial-model-create-target="forecastStep"
                        >
                            <option value="month" selected>Месяц</option>
                            <option value="quarter">Квартал</option>
                            <option value="year">Год</option>
                        </select>
                        <span class="project-form__error" data-financial-model-create-target="forecastStepError"></span>
                    </label>
                </div>

                <div class="model-create-dialog__field-grid">
                    <label class="project-form__field">
                        <span class="project-form__label">Инвестиции, мес.</span>
                        <input
                            class="project-form__input"
                            type="number"
                            min="1"
                            step="1"
                            inputmode="numeric"
                            data-financial-model-create-target="investmentDurationMonths"
                        >
                        <span class="project-form__error" data-financial-model-create-target="investmentDurationMonthsError"></span>
                    </label>

                    <label class="project-form__field">
                        <span class="project-form__label">Коммерческая работа, мес.</span>
                        <input
                            class="project-form__input"
                            type="number"
                            min="1"
                            step="1"
                            inputmode="numeric"
                            data-financial-model-create-target="commercialOperationDurationMonths"
                        >
                        <span class="project-form__error" data-financial-model-create-target="commercialOperationDurationMonthsError"></span>
                    </label>
                </div>
            </div>

            <p class="project-form__error project-form__error--form" data-financial-model-create-target="formError"></p>

            <div class="financial-model-create-dialog__actions model-create-dialog__actions">
                <button
                    class="financial-model-create-dialog__cancel model-create-dialog__cancel"
                    type="button"
                    data-action="financial-model-create#close"
                >
                    Отмена
                </button>
                <button
                    class="model-create-dialog__submit"
                    type="submit"
                    data-financial-model-create-target="submit"
                >
                    Создать модель
                </button>
            </div>
        </section>
    </form>
</dialog>
