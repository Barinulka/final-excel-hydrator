<dialog
    class="financial-model-confirm-dialog financial-model-confirm-dialog--{{ modifier }}"
    data-{{ controller }}-target="dialog"
    data-action="click->{{ controller }}#backdropClick cancel->{{ controller }}#cancel"
>
    <form
        class="financial-model-confirm-dialog__form"
        data-action="submit->{{ controller }}#submit"
        novalidate
    >
        <div class="financial-model-confirm-dialog__header">
            <h4 class="financial-model-confirm-dialog__title">{{ title }}</h4>
            <p class="financial-model-confirm-dialog__text">{{ text }}</p>
        </div>

        <p
            class="project-form__client-error financial-model-confirm-dialog__error"
            data-{{ controller }}-target="error"
        ></p>

        <div class="financial-model-confirm-dialog__actions">
            <button
                class="financial-model-confirm-dialog__cancel"
                type="button"
                data-{{ controller }}-target="cancelButton"
                data-action="{{ controller }}#cancel"
            >
                Отмена
            </button>
            <button
                class="financial-model-confirm-dialog__submit"
                type="submit"
                data-{{ controller }}-target="submit"
            >
                {{ submitLabel }}
            </button>
        </div>
    </form>
</dialog>
