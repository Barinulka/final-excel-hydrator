<article
    class="model-card{% if financialModel.isArchived %} model-card--archived{% endif %}"
    {% if financialModel.isArchived %}
        data-controller="financial-model-restore financial-model-delete"
        data-financial-model-restore-api-url-value="{{ path('api.financial_model.restore', {
            projectShortId: projectShortId,
            financialModelShortId: financialModel.shortId,
        }) }}"
        data-financial-model-delete-api-url-value="{{ path('api.financial_model.delete', {
            projectShortId: projectShortId,
            financialModelShortId: financialModel.shortId,
        }) }}"
    {% else %}
        data-controller="financial-model-rename financial-model-archive"
        data-financial-model-rename-api-url-value="{{ path('api.financial_model.rename', {
            projectShortId: projectShortId,
            financialModelShortId: financialModel.shortId,
        }) }}"
        data-financial-model-archive-api-url-value="{{ path('api.financial_model.archive', {
            projectShortId: projectShortId,
            financialModelShortId: financialModel.shortId,
        }) }}"
    {% endif %}
>
    <div class="model-card__header">
        <div class="model-card__title-block">
            <div class="model-card__title-row">
                <h3
                    class="model-card__title"
                    {% if not financialModel.isArchived %}
                        data-financial-model-rename-target="title"
                    {% endif %}
                >
                    {{ financialModel.title }}
                </h3>

                {% if not financialModel.isArchived %}
                    <button
                        class="model-card__rename-trigger"
                        type="button"
                        aria-label="Переименовать финансовую модель"
                        title="Переименовать"
                        data-financial-model-rename-target="startButton"
                        data-action="financial-model-rename#start"
                    >
                        <svg class="model-card__rename-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                            <path d="M13.8 2.7a2.1 2.1 0 0 1 3 3L7.4 15.1l-4.2.9.9-4.2 9.7-9.1Zm1.9 1.1a.6.6 0 0 0-.8 0L5.5 12.6l-.3 1.5 1.5-.3 9-9a.6.6 0 0 0 0-1Z" />
                        </svg>
                    </button>
                {% endif %}
            </div>
        </div>

        {% if financialModel.isArchived %}
            <span class="model-card__status">В архиве</span>
        {% endif %}
    </div>

    {% if not financialModel.isArchived %}
        <dialog
            class="financial-model-rename-dialog"
            data-financial-model-rename-target="dialog"
            data-action="click->financial-model-rename#backdropClick cancel->financial-model-rename#cancel"
        >
            <form
                class="financial-model-rename-dialog__form"
                data-action="submit->financial-model-rename#submit"
                novalidate
            >
                <div class="financial-model-rename-dialog__header">
                    <h4 class="financial-model-rename-dialog__title">Переименовать модель</h4>
                    <p class="financial-model-rename-dialog__text">Название изменится только для этого сценария проекта.</p>
                </div>

                <label class="project-form__field" for="financial_model_rename_{{ financialModel.shortId }}">
                    <span class="project-form__label">Название модели</span>
                    <input
                        id="financial_model_rename_{{ financialModel.shortId }}"
                        class="project-form__input"
                        type="text"
                        maxlength="255"
                        value="{{ financialModel.title }}"
                        autocomplete="off"
                        data-financial-model-rename-target="input"
                    >
                    <span
                        class="project-form__client-error"
                        data-financial-model-rename-target="error"
                    ></span>
                </label>

                <div class="financial-model-rename-dialog__actions">
                    <button
                        class="financial-model-rename-dialog__cancel"
                        type="button"
                        data-financial-model-rename-target="cancelButton"
                        data-action="financial-model-rename#cancel"
                    >
                        Отмена
                    </button>
                    <button
                        class="projects-content__action"
                        type="submit"
                        data-financial-model-rename-target="submit"
                    >
                        Сохранить
                    </button>
                </div>
            </form>
        </dialog>

        <dialog
            class="financial-model-archive-dialog"
            data-financial-model-archive-target="dialog"
            data-action="click->financial-model-archive#backdropClick cancel->financial-model-archive#cancel"
        >
            <form
                class="financial-model-archive-dialog__form"
                data-action="submit->financial-model-archive#submit"
                novalidate
            >
                <div class="financial-model-archive-dialog__header">
                    <h4 class="financial-model-archive-dialog__title">Архивировать модель?</h4>
                    <p class="financial-model-archive-dialog__text">
                        Модель останется в списке проекта, но будет недоступна для открытия и редактирования.
                    </p>
                </div>

                <p
                    class="project-form__client-error financial-model-archive-dialog__error"
                    data-financial-model-archive-target="error"
                ></p>

                <div class="financial-model-archive-dialog__actions">
                    <button
                        class="financial-model-archive-dialog__cancel"
                        type="button"
                        data-financial-model-archive-target="cancelButton"
                        data-action="financial-model-archive#cancel"
                    >
                        Отмена
                    </button>
                    <button
                        class="financial-model-archive-dialog__submit"
                        type="submit"
                        data-financial-model-archive-target="submit"
                    >
                        Архивировать
                    </button>
                </div>
            </form>
        </dialog>
    {% else %}
        <dialog
            class="financial-model-restore-dialog"
            data-financial-model-restore-target="dialog"
            data-action="click->financial-model-restore#backdropClick cancel->financial-model-restore#cancel"
        >
            <form
                class="financial-model-restore-dialog__form"
                data-action="submit->financial-model-restore#submit"
                novalidate
            >
                <div class="financial-model-restore-dialog__header">
                    <h4 class="financial-model-restore-dialog__title">Восстановить модель?</h4>
                    <p class="financial-model-restore-dialog__text">
                        Модель снова станет доступна для открытия, редактирования и расчетных действий.
                    </p>
                </div>

                <p
                    class="project-form__client-error financial-model-restore-dialog__error"
                    data-financial-model-restore-target="error"
                ></p>

                <div class="financial-model-restore-dialog__actions">
                    <button
                        class="financial-model-restore-dialog__cancel"
                        type="button"
                        data-financial-model-restore-target="cancelButton"
                        data-action="financial-model-restore#cancel"
                    >
                        Отмена
                    </button>
                    <button
                        class="financial-model-restore-dialog__submit"
                        type="submit"
                        data-financial-model-restore-target="submit"
                    >
                        Восстановить
                    </button>
                </div>
            </form>
        </dialog>

        <dialog
            class="financial-model-delete-dialog"
            data-financial-model-delete-target="dialog"
            data-action="click->financial-model-delete#backdropClick cancel->financial-model-delete#cancel"
        >
            <form
                class="financial-model-delete-dialog__form"
                data-action="submit->financial-model-delete#submit"
                novalidate
            >
                <div class="financial-model-delete-dialog__header">
                    <h4 class="financial-model-delete-dialog__title">Удалить модель полностью?</h4>
                    <p class="financial-model-delete-dialog__text">
                        Это действие нельзя отменить. Все данные этой финансовой модели будут удалены.
                    </p>
                </div>

                <p
                    class="project-form__client-error financial-model-delete-dialog__error"
                    data-financial-model-delete-target="error"
                ></p>

                <div class="financial-model-delete-dialog__actions">
                    <button
                        class="financial-model-delete-dialog__cancel"
                        type="button"
                        data-financial-model-delete-target="cancelButton"
                        data-action="financial-model-delete#cancel"
                    >
                        Отмена
                    </button>
                    <button
                        class="financial-model-delete-dialog__submit"
                        type="submit"
                        data-financial-model-delete-target="submit"
                    >
                        Удалить
                    </button>
                </div>
            </form>
        </dialog>
    {% endif %}

    <p class="model-card__text">Сценарий v{{ financialModel.versionNumber }}</p>

    <dl class="model-card__metrics">
        <div class="model-card__metric">
            <dt>Старт</dt>
            <dd>{{ financialModel.investmentStartMonth }}</dd>
        </div>
        <div class="model-card__metric">
            <dt>Горизонт</dt>
            <dd>{{ financialModel.totalDurationMonths }} мес.</dd>
        </div>
        <div class="model-card__metric">
            <dt>Инвестиции</dt>
            <dd>{{ financialModel.investmentDurationMonths }} мес.</dd>
        </div>
        <div class="model-card__metric">
            <dt>Работа</dt>
            <dd>{{ financialModel.commercialOperationDurationMonths }} мес.</dd>
        </div>
    </dl>

    <p class="model-card__hint">Шаг прогнозирования: {{ financialModel.forecastStepLabel }}</p>

    {% if financialModel.isArchived %}
        <div class="model-card__actions">
            <button class="model-card__link" type="button" disabled>
                Открыть модель
            </button>
            <button
                class="model-card__restore"
                type="button"
                data-action="financial-model-restore#start"
            >
                Восстановить
            </button>
            <button
                class="model-card__delete"
                type="button"
                data-action="financial-model-delete#start"
            >
                Удалить
            </button>
        </div>
    {% else %}
        <div class="model-card__actions">
            <a
                class="model-card__link"
                href="{{ path('app_financial_model_time_params', {
                    projectShortId: projectShortId,
                    financialModelShortId: financialModel.shortId,
                }) }}"
                data-turbo-frame="_top"
            >
                Открыть модель
            </a>
            <button
                class="model-card__archive"
                type="button"
                data-action="financial-model-archive#start"
            >
                В архив
            </button>
        </div>
    {% endif %}
</article>
