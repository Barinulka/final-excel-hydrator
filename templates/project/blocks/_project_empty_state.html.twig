<section class="projects-content" aria-labelledby="projects-content-title">
    <div class="projects-content__toolbar">
        <div class="projects-content__headline">
            <h2 class="projects-content__title" id="projects-content-title">
                {{ hasProjects ? 'Выберите проект' : 'Проекты' }}
            </h2>
            <p class="projects-content__lead">
                {{ hasProjects ? 'Откройте проект слева, чтобы увидеть его финансовые модели.' : 'Создайте проект, чтобы собрать финансовые модели и сравнить сценарии.' }}
            </p>
        </div>

        <button
            class="projects-content__action"
            type="button"
            data-action="project-create#open"
        >
            Добавить проект
        </button>
    </div>

    <div class="projects-empty">
        <p class="projects-empty__title">
            {{ hasProjects ? 'Проект не выбран' : 'Проекты пока не созданы' }}
        </p>
        <p class="projects-empty__text">
            {{ hasProjects ? 'Выберите проект в списке слева.' : 'Добавьте первый проект, чтобы начать работу с финансовыми моделями.' }}
        </p>

        <button
            class="projects-empty__btn"
            type="button"
            data-action="project-create#open"
        >
            Добавить проект
        </button>
    </div>
</section>
