<aside class="projects-sidebar" aria-labelledby="projects-sidebar-title">
    <div class="projects-sidebar__intro">
        <h1 class="projects-sidebar__title" id="projects-sidebar-title">Проекты</h1>
        <p class="projects-sidebar__lead">Рабочее пространство по проектам и моделям.</p>
    </div>

    {% if projects|length > 0 %}
        <nav class="projects-sidebar__nav" aria-label="Список проектов">
            {% for project in projects %}
                {% set isActive = project.shortId == selectedProjectShortId %}
                <div class="projects-sidebar__row{% if isActive %} projects-sidebar__row--active{% endif %}{% if project.isArchived %} projects-sidebar__row--archived{% endif %}">
                    <a
                        class="projects-sidebar__item{% if isActive %} projects-sidebar__item--active{% endif %}"
                        href="{{ path('app_project_page', {projectShortId: project.shortId}) }}"
                        data-turbo-frame="project_workspace"
                        data-turbo-action="advance"
                        {% if isActive %}aria-current="page"{% endif %}
                    >
                        <span class="projects-sidebar__name">{{ project.title }}</span>
                        {% if project.isArchived %}
                            <span class="projects-sidebar__meta">В архиве</span>
                        {% endif %}
                    </a>
                </div>
            {% endfor %}
        </nav>
    {% else %}
        <p class="projects-sidebar__empty">Проекты пока не созданы.</p>
    {% endif %}
</aside>
