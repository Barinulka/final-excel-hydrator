<turbo-frame
    id="project_workspace"
    data-turbo-action="advance"
    data-controller="project-create"
    data-project-create-api-url-value="{{ path('api.project.create') }}"
>
    <div class="projects-layout">
        {% include 'project/blocks/_project_sidebar.html.twig' with {
            projects: page.projectList.projects,
            selectedProjectShortId: page.selectedProjectShortId,
        } only %}

        {% if page.selectedProject %}
            {% include 'project/blocks/_project_content.html.twig' with {
                page: page,
            } only %}
        {% else %}
            {% include 'project/blocks/_project_empty_state.html.twig' with {
                hasProjects: page.hasProjects,
            } only %}
        {% endif %}
    </div>

    {% include 'project/blocks/_project_create_modal.html.twig' only %}
</turbo-frame>
