<dialog
    class="project-create-dialog"
    data-project-create-target="dialog"
    data-action="click->project-create#backdropClick"
>
    <form
        class="project-create-dialog__form"
        data-action="submit->project-create#submit"
        novalidate
    >
        <div class="project-create-dialog__header">
            <h3 class="project-create-dialog__title">Новый проект</h3>
            <p class="project-create-dialog__text">Укажите название проекта. Финансовые модели добавляются внутри проекта.</p>
        </div>

        <div class="project-form__field">
            <label class="project-form__label" for="project_create_title">Название проекта</label>
            <input
                id="project_create_title"
                class="project-form__input"
                type="text"
                name="title"
                maxlength="255"
                autocomplete="off"
                data-project-create-target="title"
            >
            <p class="project-form__error" data-project-create-target="titleError"></p>
        </div>

        <div class="project-form__field">
            <label class="project-form__label" for="project_create_description">Описание</label>
            <textarea
                id="project_create_description"
                class="project-form__textarea"
                name="description"
                rows="4"
                maxlength="2000"
                data-project-create-target="description"
            ></textarea>
            <p class="project-form__error" data-project-create-target="descriptionError"></p>
        </div>

        <p class="project-form__error project-form__error--form" data-project-create-target="formError"></p>

        <div class="project-create-dialog__actions">
            <button
                class="project-create-dialog__cancel"
                type="button"
                data-action="project-create#close"
            >
                Отмена
            </button>
            <button
                class="projects-content__action"
                type="submit"
                data-project-create-target="submit"
            >
                Создать проект
            </button>
        </div>
    </form>
</dialog>
