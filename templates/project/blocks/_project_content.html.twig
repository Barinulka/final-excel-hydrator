{% set selectedProject = page.selectedProject %}
{% set selectedProjectItem = page.selectedProjectListItem %}
{% set selectedProjectArchived = selectedProjectItem and selectedProjectItem.isArchived %}

<section
    class="projects-content"
    aria-labelledby="projects-content-title"
    {% if not selectedProjectArchived %}
        data-controller="financial-model-create project-edit"
        data-financial-model-create-api-url-value="{{ path('api.financial_model.create', {projectShortId: selectedProject.projectShortId}) }}"
        data-project-edit-api-url-value="{{ path('api.project.update_details', {projectShortId: selectedProject.projectShortId}) }}"
    {% endif %}
>
    <div class="projects-content__toolbar">
        <div class="projects-content__headline">
            <div class="projects-content__title-row">
                <h2 class="projects-content__title" id="projects-content-title">
                    {{ selectedProject.projectTitle }}
                </h2>

                {% if not selectedProjectArchived %}
                    <button
                        class="projects-content__edit-trigger"
                        type="button"
                        aria-label="Редактировать проект"
                        title="Редактировать проект"
                        data-action="project-edit#open"
                    >
                        <svg class="projects-content__edit-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                            <path d="M13.8 2.7a2.1 2.1 0 0 1 3 3L7.4 15.1l-4.2.9.9-4.2 9.7-9.1Zm1.9 1.1a.6.6 0 0 0-.8 0L5.5 12.6l-.3 1.5 1.5-.3 9-9a.6.6 0 0 0 0-1Z" />
                        </svg>
                    </button>
                {% endif %}

                {% if selectedProjectArchived %}
                    <span class="projects-content__status">В архиве</span>
                {% endif %}
            </div>
            <p class="projects-content__lead">
                {{ selectedProject.projectDescription ?: 'Описание проекта пока не заполнено.' }}
            </p>
        </div>

        <div class="projects-content__controls">
            <button
                class="projects-content__ghost"
                type="button"
                data-action="project-create#open"
            >
                Добавить проект
            </button>
            <button
                class="projects-content__action"
                type="button"
                {% if selectedProjectArchived %}
                    disabled
                {% else %}
                    data-action="financial-model-create#open"
                {% endif %}
            >
                Создать модель
            </button>
        </div>
    </div>

    <div class="workspace-summary" aria-label="Сводка проекта">
        <div class="workspace-summary__item">
            <span class="workspace-summary__label">Сценариев</span>
            <strong class="workspace-summary__value">{{ selectedProject.financialModelCount() }}</strong>
        </div>
        <div class="workspace-summary__item">
            <span class="workspace-summary__label">В работе</span>
            <strong class="workspace-summary__value">{{ selectedProject.activeFinancialModelCount() }}</strong>
        </div>
        <div class="workspace-summary__item">
            <span class="workspace-summary__label">В архиве</span>
            <strong class="workspace-summary__value">{{ selectedProject.archivedFinancialModelCount() }}</strong>
        </div>
    </div>

    <section class="project-models" aria-labelledby="project-models-title">
        <div class="project-models__header">
            <h3 class="project-models__title" id="project-models-title">Сценарии проекта</h3>
            <p class="project-models__lead">Финансовые модели с разными сроками, инвестициями и расчетными допущениями.</p>
        </div>

        {% if selectedProject.financialModels|length > 0 %}
            <div class="projects-content__cards projects-content__cards--models">
                {% for financialModel in selectedProject.financialModels %}
                    {% include 'project/blocks/_financial_model_card.html.twig' with {
                        financialModel: financialModel,
                        projectShortId: selectedProject.projectShortId,
                    } only %}
                {% endfor %}
            </div>
        {% else %}
            <div class="projects-empty">
                <p class="projects-empty__title">Финансовых моделей пока нет</p>
                <p class="projects-empty__text">Создайте первую модель, чтобы заполнить временные параметры и перейти к расчетным блокам.</p>
                <button
                    class="projects-empty__btn"
                    type="button"
                    {% if selectedProjectArchived %}
                        disabled
                    {% else %}
                        data-action="financial-model-create#open"
                    {% endif %}
                >
                    Создать модель
                </button>
            </div>
        {% endif %}
    </section>

    {% if not selectedProjectArchived %}
        {% include 'project/blocks/_project_edit_modal.html.twig' with {
            selectedProject: selectedProject,
        } only %}

        {% include 'project/blocks/_financial_model_create_modal.html.twig' only %}
    {% endif %}
</section>
